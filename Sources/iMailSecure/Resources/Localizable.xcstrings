    "Der Autocrypt-Header enthält keinen lesbaren Schlüssel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Autocrypt header does not contain a readable key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cabecera Autocrypt no contiene ninguna clave legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'en-tête Autocrypt ne contient aucune clé lisible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок Autocrypt не содержит читаемого ключа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocrypt başlığında okunabilir bir anahtar yok."
          }
        }
      }
    },
    "Der Inhalt dieser Nachricht ist verschlüsselt und wird in dieser Version nicht entschlüsselt angezeigt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content of this message is encrypted and is not decrypted in this version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de este mensaje está cifrado y no se descifra en esta versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de ce message est chiffré et n'est pas déchiffré dans cette version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое этого сообщения зашифровано и в этой версии не расшифровывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iletinin içeriği şifrelenmiştir ve bu sürümde şifresi çözülmez."
          }
        }
      }
    },
    "Der Ordner und alle enthaltenen Nachrichten werden auf dem Server gelöscht. Das lässt sich nicht rückgängig machen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder and all messages in it will be deleted on the server. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta y todos los mensajes que contiene se eliminarán en el servidor. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier et tous les messages qu'il contient seront supprimés sur le serveur. Cette action est irréversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка и все сообщения в ней будут удалены на сервере. Отменить это нельзя."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör ve içindeki tüm iletiler sunucudan silinecek. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "Der Ordner wird auf dem Server von %@ angelegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder will be created on the server for %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta se creará en el servidor de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier sera créé sur le serveur de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка будет создана на сервере %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör %@ sunucusunda oluşturulacak."
          }
        }
      }
    },
    "Der Ordner wird auf dem Server von %@ umbenannt. Nachrichten bleiben erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder will be renamed on the server for %@. Messages are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta se renombrará en el servidor de %@. Los mensajes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier sera renommé sur le serveur de %@. Les messages sont conservés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка будет переименована на сервере %@. Сообщения сохранятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör %@ sunucusunda yeniden adlandırılacak. İletiler korunur."
          }
        }
      }
    },
    "Der Schlüssel für %@ und die zugehörige Passphrase werden von diesem Gerät gelöscht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key for %@ and its passphrase will be deleted from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de %@ y su frase de contraseña se eliminarán de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé pour %@ et sa phrase secrète seront supprimées de cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ для %@ и его парольная фраза будут удалены с этого устройства."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için anahtar ve parolası bu cihazdan silinecek."
          }
        }
      }
    },
    "Der Schlüssel gehört zu %@, nicht zu %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key belongs to %@, not to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave pertenece a %@, no a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé appartient à %@, et non à %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ принадлежит %@, а не %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar %@ adresine ait, %@ adresine değil."
          }
        }
      }
    },
    "Der Schlüssel konnte nicht gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé n'a pas pu être enregistrée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar kaydedilemedi."
          }
        }
      }
    },
    "Der WKD-Server antwortete mit Status %d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WKD server responded with status %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor WKD respondió con el estado %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur WKD a répondu avec le statut %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер WKD ответил со статусом %d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WKD sunucusu %d durumuyla yanıt verdi."
          }
        }
      }
    },
    "Der WKD-Server lieferte keinen Schlüssel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WKD server returned no key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor WKD no devolvió ninguna clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur WKD n'a renvoyé aucune clé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер WKD не вернул ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WKD sunucusu bir anahtar döndürmedi."
          }
        }
      }
    },
    "Der geheime Schlüssel und seine Passphrase liegen nur auf diesem Gerät und werden nicht synchronisiert. Die App kann damit Mail signieren, sobald du es im Verfassen-Fenster aktivierst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key and its passphrase stay on this device only and are not synced. Once you enable it while composing, the app can use it to sign mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave privada y su frase de contraseña permanecen solo en este dispositivo y no se sincronizan. La app puede usarla para firmar correos si la activas al redactar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé privée et sa phrase secrète restent uniquement sur cet appareil et ne sont pas synchronisées. L'application peut l'utiliser pour signer les messages si vous l'activez lors de la rédaction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый ключ и его парольная фраза остаются только на этом устройстве и не синхронизируются. Приложение сможет подписывать письма, если вы включите это при создании письма."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtar ve parolası yalnızca bu cihazda kalır ve eşitlenmez. Uygulama, mesaj oluştururken etkinleştirirseniz postaları imzalayabilir."
          }
        }
      }
    },
    "Der gemeinsame Posteingang bündelt alle Konten und ist Teil von Pro.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unified inbox combines all accounts and is part of Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La bandeja de entrada unificada reúne todas las cuentas y forma parte de Pro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La boîte de réception unifiée regroupe tous les comptes et fait partie de Pro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Общий почтовый ящик объединяет все учётные записи и входит в Pro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birleşik gelen kutusu tüm hesapları bir araya getirir ve Pro'nun parçasıdır."
          }
        }
      }
    },
    "Der gespeicherte Fingerabdruck für %@:%lld wird gelöscht. Danach wäre ein Man-in-the-Middle nicht mehr erkennbar — nur tun, wenn du das neue Zertifikat geprüft hast.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stored fingerprint for %1$@:%2$lld will be deleted. After that, a man-in-the-middle attack can no longer be detected — only do this if you have verified the new certificate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará la huella guardada de %1$@:%2$lld. Después, un ataque de intermediario ya no se podrá detectar; hazlo solo si has verificado el nuevo certificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'empreinte enregistrée pour %1$@:%2$lld sera supprimée. Ensuite, une attaque de l'homme du milieu ne pourra plus être détectée — ne le faites que si vous avez vérifié le nouveau certificat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый отпечаток для %1$@:%2$lld будет удалён. После этого атаку «человек посередине» больше нельзя будет обнаружить — делайте это только после проверки нового сертификата."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$lld için kayıtlı parmak izi silinecek. Bundan sonra ortadaki adam saldırısı artık algılanamaz — yalnızca yeni sertifikayı doğruladıysanız yapın."
          }
        }
      }
    },
    "Der private Schlüssel konnte nicht gespeichert werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé privée n'a pas pu être enregistrée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить закрытый ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtar kaydedilemedi."
          }
        }
      }
    },
    "Die Abfrage geht ausschließlich an die Domain der Adresse und nur, wenn du sie hier startest. Es wird kein Keyserver und kein anderer Dritter gefragt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request goes only to the domain of the address, and only when you start it here. No key server or other third party is contacted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta se envía solo al dominio de la dirección y solo cuando la inicias aquí. No se contacta a ningún servidor de claves ni a otros terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête va uniquement au domaine de l'adresse, et seulement si vous la lancez ici. Aucun serveur de clés ni autre tiers n'est contacté."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос уходит только на домен адреса и только когда вы запускаете его здесь. Ни к серверу ключей, ни к другим третьим лицам обращения нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorgu yalnızca adresin etki alanına gider ve yalnızca burada başlattığınızda gönderilir. Anahtar sunucusuna veya başka bir üçüncü tarafa başvurulmaz."
          }
        }
      }
    },
    "Die Abos sind derzeit nicht verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions are currently unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones no están disponibles en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements ne sont pas disponibles pour le moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки сейчас недоступны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikler şu anda kullanılamıyor."
          }
        }
      }
    },
    "Die Antwort des WKD-Servers ist ungewöhnlich groß und wurde verworfen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WKD server's response is unusually large and was discarded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del servidor WKD es inusualmente grande y se descartó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du serveur WKD est inhabituellement volumineuse et a été ignorée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ сервера WKD необычно большой и был отброшен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WKD sunucusunun yanıtı olağandışı şekilde büyük ve atıldı."
          }
        }
      }
    },
    "Die Kryptographie-Bibliothek meldet einen Fehler.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cryptography library reported an error."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca criptográfica ha notificado un error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque cryptographique a signalé une erreur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека криптографии сообщила об ошибке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kriptografi kitaplığı bir hata bildirdi."
          }
        }
      }
    },
    "Die Nachricht ist unverändert. Signiert mit dem Schlüssel von %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is unchanged. Signed with the key of %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no ha cambiado. Firmado con la clave de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est inchangé. Signé avec la clé de %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение не изменено. Подписано ключом %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleti değiştirilmemiş. %@ anahtarıyla imzalanmış."
          }
        }
      }
    },
    "Die Nachricht wurde nach dem Signieren verändert, oder die Signatur stammt nicht von dem Schlüssel, den sie beansprucht. Behandle den Inhalt als unzuverlässig.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message was altered after signing, or the signature does not come from the key it claims. Treat the content as unreliable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje se modificó después de firmarse, o la firma no procede de la clave que afirma. Trata el contenido como poco fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message a été modifié après signature, ou la signature ne provient pas de la clé qu'elle revendique. Considérez le contenu comme non fiable."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение изменено после подписания или подпись принадлежит не тому ключу, который заявлен. Считайте содержимое ненадёжным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleti imzalandıktan sonra değiştirilmiş veya imza iddia ettiği anahtara ait değil. İçeriği güvenilmez kabul edin."
          }
        }
      }
    },
    "Die Passphrase passt nicht zum geheimen Schlüssel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase does not match the private key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contraseña no coincide con la clave privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secrète ne correspond pas à la clé privée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Парольная фраза не подходит к закрытому ключу."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola özel anahtarla eşleşmiyor."
          }
        }
      }
    },
    "Die Signatur konnte nicht gelesen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signature could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature n'a pas pu être lue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать подпись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmza okunamadı."
          }
        }
      }
    },
    "Die Signatur umfasst Text und Anhänge. Sie wird mit deinem privaten Schlüssel erstellt, der nur auf diesem Gerät liegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signature covers text and attachments. It is created with your private key, which stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma cubre el texto y los archivos adjuntos. Se crea con tu clave privada, que permanece en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature couvre le texte et les pièces jointes. Elle est créée avec votre clé privée, qui reste sur cet appareil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись охватывает текст и вложения. Она создаётся вашим закрытым ключом, который остаётся на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmza metni ve ekleri kapsar. Yalnızca bu cihazda kalan özel anahtarınızla oluşturulur."
          }
        }
      }
    },
    "Die WKD-Abfrage schlug fehl: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The WKD lookup failed: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta WKD falló: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche WKD a échoué : %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос WKD не удался: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "WKD sorgusu başarısız oldu: %@"
          }
        }
      }
    },
    "Diese Nachricht enthält einen Autocrypt-Header. Der Schlüssel stammt aus dem Kopf der Nachricht, nicht von einem Server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message contains an Autocrypt header. The key comes from the message header, not from a server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mensaje contiene una cabecera Autocrypt. La clave procede de la cabecera del mensaje, no de un servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce message contient un en-tête Autocrypt. La clé provient de l'en-tête du message, et non d'un serveur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сообщение содержит заголовок Autocrypt. Ключ взят из заголовка сообщения, а не с сервера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ileti bir Autocrypt başlığı içeriyor. Anahtar bir sunucudan değil, iletinin başlığından geliyor."
          }
        }
      }
    },
    "Dieser Absender ist dauerhaft freigegeben. Widerruf wirkt sofort und für alle künftigen Mails.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sender is permanently allowed. Revoking takes effect immediately and for all future emails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este remitente está permitido de forma permanente. La revocación se aplica de inmediato y a todos los correos futuros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet expéditeur est autorisé en permanence. La révocation prend effet immédiatement et pour tous les e-mails à venir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот отправитель разрешён навсегда. Отзыв действует сразу и для всех будущих писем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
