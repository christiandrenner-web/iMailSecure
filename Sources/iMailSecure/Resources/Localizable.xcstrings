    "Freigabe gilt nur für diese Mail und endet beim Schließen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission applies only to this email and ends when you close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso solo se aplica a este correo y finaliza al cerrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation ne s'applique qu'à cet e-mail et prend fin à sa fermeture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение действует только для этого письма и заканчивается при его закрытии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin yalnızca bu e-posta için geçerlidir ve kapattığınızda sona erer."
          }
        }
      }
    },
    "Für %@ ist kein öffentlicher Schlüssel hinterlegt. Die Signatur lässt sich deshalb nicht prüfen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public key is stored for %@. The signature therefore cannot be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave pública guardada para %@. Por eso no se puede verificar la firma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé publique n'est enregistrée pour %@. La signature ne peut donc pas être vérifiée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ нет сохранённого открытого ключа. Поэтому подпись нельзя проверить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için kayıtlı açık anahtar yok. Bu nedenle imza doğrulanamıyor."
          }
        }
      }
    },
    "Für diese Adresse ist kein öffentlicher Schlüssel hinterlegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public key is stored for this address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave pública guardada para esta dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé publique n'est enregistrée pour cette adresse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого адреса нет сохранённого открытого ключа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adres için kayıtlı açık anahtar yok."
          }
        }
      }
    },
    "Für diese Adresse veröffentlicht die Domain keinen Schlüssel per WKD.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The domain does not publish a key for this address via WKD."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dominio no publica ninguna clave para esta dirección mediante WKD."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le domaine ne publie aucune clé pour cette adresse via WKD."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Домен не публикует ключ для этого адреса через WKD."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etki alanı bu adres için WKD üzerinden bir anahtar yayımlamıyor."
          }
        }
      }
    },
    "Für dieses Konto ist kein privater Schlüssel hinterlegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No private key is stored for this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave privada guardada para esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé privée n'est enregistrée pour ce compte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой учётной записи не сохранён закрытый ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesap için özel anahtar kayıtlı değil."
          }
        }
