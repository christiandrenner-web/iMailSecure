    "Auch ein Autocrypt-Header ist nur ein Hinweis. Vergleiche den Fingerprint über einen zweiten Weg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Autocrypt header is only a hint too. Compare the fingerprint using a second channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cabecera Autocrypt también es solo una pista. Compara la huella digital por otro medio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un en-tête Autocrypt n'est lui aussi qu'une indication. Comparez l'empreinte par un autre canal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок Autocrypt — тоже лишь указание. Сверьте отпечаток через второй канал."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autocrypt başlığı da sadece bir ipucudur. Parmak izini ikinci bir yoldan karşılaştırın."
          }
        }
      }
    },
