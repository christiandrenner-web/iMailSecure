        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte de %@ supprimée. À la prochaine connexion, l'empreinte actuelle sera acceptée sans comparaison."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отпечаток для %@ удалён. При следующем подключении текущий отпечаток будет принят без сравнения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
