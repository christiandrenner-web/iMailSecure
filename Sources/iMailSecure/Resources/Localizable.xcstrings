    "Öffentliche Schlüssel werden nur auf diesem Gerät gespeichert. Es gibt keine automatische Keyserver-Abfrage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public keys are stored on this device only. There is no automatic keyserver lookup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves públicas se guardan solo en este dispositivo. No hay consultas automáticas a servidores de claves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés publiques restent sur cet appareil. Aucune interrogation automatique de serveur de clés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые ключи хранятся только на этом устройстве. Автоматических запросов к серверам ключей нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık anahtarlar yalnızca bu cihazda saklanır. Otomatik anahtar sunucusu sorgusu yoktur."
          }
        }
      }
    },
